# Keep the real git identity/credentials before HOME is redirected — git
# resolves its global config as $HOME/.gitconfig, which would otherwise point
# into the empty sandbox below (name/email/credential helper all gone).
export GIT_CONFIG_GLOBAL="${GIT_CONFIG_GLOBAL:-$HOME/.gitconfig}"

# Per-project HOME sandbox: everything the devshell writes to "$HOME" (tool
# caches, configs, state) lands in ./.home instead of the real home directory,
# so projects can't leak into each other or into ~.
export HOME="$PWD/.home"
mkdir -p "$HOME"

# Reload the shell when the package list changes (xin add/remove also trigger
# an explicit reload, but this covers hand edits).
watch_file packages.nix

# nix-direnv (loaded from ~/.config/direnv/direnvrc) makes this cached + GC-rooted.
use flake
